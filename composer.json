{
  "name": "sugarcommerce/pages",
  "description": "Create the pages a plugin needs, remember them by name, and label them in the admin list so nobody deletes one by accident.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/pages",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "SugarCommerce\\Pages\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/sugarcommerce/pages/issues",
    "source": "https://github.com/sugarcommerce/pages"
  },
  "keywords": [
    "wordpress",
    "pages",
    "setup",
    "post-states"
  ],
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\Pages\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  }
}
